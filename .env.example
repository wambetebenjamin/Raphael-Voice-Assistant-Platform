# ─────────────────────────────────────────────────────────────────────────────
# Raphael Voice — environment variables
# EVERY variable is optional. With none of them set the site still builds,
# deploys and runs: captcha switches to "off" (visible notice in the UI),
# KV switches to an in-process store, mail becomes a logged dry-run and the
# live board uses a simulated baseline. Set them for production.
# ─────────────────────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL=https://raphael-voice.example.com

# reCAPTCHA v3 (server secret + browser site key)
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# reCAPTCHA v2 checkbox — served as fallback when a v3 score is below 0.5
RECAPTCHA_V2_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_V2_SITE_KEY=

# Vercel KV / Upstash Redis (demo sessions, licence applications, newsletter,
# live presence board). The Vercel KV integration injects these automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Equivalent Upstash names, also honoured:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Mail (Nodemailer). Either a full SMTP_URL …
SMTP_URL=smtps://user:pass@smtp.example.com:465
# … or the split form:
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Raphael Voice <hello@raphael-voice.example.com>"
MAIL_TO=hello@raphael-voice.example.com

# WhatsApp (also hardcoded as a safe default: +254 112 272 061)
NEXT_PUBLIC_WHATSAPP_NUMBER=254112272061

# Optional external WebSocket endpoint for the live usage board.
# Vercel Functions cannot hold WebSocket connections, so when this is unset the
# client falls back to polling /api/ws (same data contract).
NEXT_PUBLIC_WS_URL=
